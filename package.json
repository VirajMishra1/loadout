{
  "name": "loadout-ai",
  "version": "0.9.0",
  "private": false,
  "license": "MIT",
  "description": "The package manager for AI coding agent extensions",
  "type": "module",
  "bin": {
    "loadout": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "catalog",
    "skills",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VirajMishra1/loadout.git"
  },
  "homepage": "https://github.com/VirajMishra1/loadout#readme",
  "bugs": {
    "url": "https://github.com/VirajMishra1/loadout/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai-agents",
    "agent-skills",
    "ai-coding",
    "codex",
    "claude-code",
    "cursor",
    "gemini-cli",
    "mcp",
    "skills",
    "developer-tools",
    "model-context-protocol"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "dev": "tsx src/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src tests vitest.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run test:e2e:cli",
    "pretest:e2e:cli": "npm run build",
    "test:e2e:cli": "node scripts/cli-product-flow.mjs",
    "test:e2e:readme": "node scripts/readme-product-flow.mjs",
    "test:e2e:coordination": "npm run build && node scripts/coordination-product-flow.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "pretest:performance": "npm run build",
    "test:coverage": "vitest run --coverage",
    "test:performance": "node scripts/scan-benchmark.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "readme:update": "node scripts/update-readme-facts.mjs",
    "readme:check": "node scripts/update-readme-facts.mjs --check",
    "check:readme-claims": "npm run build && node scripts/check-readme-claims.mjs",
    "check:live": "node scripts/check-live-evidence.mjs",
    "check:allowlists": "npm run build && node scripts/check-mode-allowlists.mjs",
    "check:catalog-freshness": "npm run build && node scripts/check-catalog-freshness.mjs",
    "check:audit": "npm audit --audit-level=high",
    "check:evidence": "node scripts/check-catalog-attribution.mjs && node scripts/check-discovery-artifacts.mjs && node scripts/check-documented-commands.mjs && npm run check:readme-claims",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run check:audit && npm run check:evidence && npm test -- --run && npm run test:e2e:cli && npm run test:e2e:readme && npm run test:e2e:coordination && npm run test:package && npm run test:performance",
    "verify:full": "npm run verify && npm run test:coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openai/codex-sdk": "^0.153.2",
    "commander": "^12.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
